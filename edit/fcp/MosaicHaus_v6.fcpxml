-transform><param name="scale" key="scale"><keyframeAnimation><keyframe time="1/3s" value="1.0000 1.0000"/><keyframe time="53/24s" value="1.0600 1.0600"/></keyframeAnimation></param></adjust-transform><adjust-blend><param name="amount" key="amount"><keyframeAnimation><keyframe time="1/3s" value="0"/><keyframe time="5/8s" value="1"/></keyframeAnimation></param></adjust-blend><asset-clip ref="r3" name="Antidote (sped up) 0:00-0:30" lane="-1" offset="1/3s" start="0s" duration="30s" audioRole="music"/><asset-clip ref="r4" name="Sound design stem" lane="-2" offset="1/3s" start="0s" duration="30s" audioRole="effects"/></asset-clip><asset-clip name="hanky_cu" ref="r5" offset="15/8s" start="3/2s" duration="11/6s" format="r1" tcFormat="NDF"><note>the friend finishes dabbing his eye and stares into the lens (new Higgsfield close-up)</note><adjust-transform><param name="scale" key="scale"><keyframeAnimation><keyframe time="3/2s" value="1.0000 1.0000"/><keyframe time="10/3s" value="1.0500 1.0500"/></keyframeAnimation></param></adjust-transform></asset-clip><asset-clip name="tear" ref="r6" offset="89/24s" start="5/4s" duration="11/12s" format="r1" tcFormat="NDF"><note>the elder's tear</note><adjust-transform><param name="scale" key="scale"><keyframeAnimation><keyframe time="5/4s" value="1.0000 1.0000"/><keyframe time="13/6s" value="1.0800 1.0800"/></keyframeAnimation></param></adjust-transform></asset-clip><asset-clip name="puddle" ref="r7" offset="37/8s" start="0s" duration="11/12s" format="r1" tcFormat="NDF"><note>the drop falls, slightly slowed: wait for it</note><timeMap frameSampling="frame-blending"><timept time="0s" value="0s" interp="linear"/><timept time="11/12s" value="2/3s" interp="linear"/></timeMap></asset-clip><asset-clip name="puddle" ref="r7" offset="133/24s" start="2/3s" duration="11/8s" format="r1" tcFormat="NDF"><note>IMPACT 5.54s: drop hits the puddle ON the bass drop</note><adjust-transform><param name="scale" key="scale"><keyframeAnimation><keyframe time="2/3s" value="1.1400 1.1400"/><keyframe time="5/6s" value="1.0700 1.0700"/><keyframe time="1s" value="1.0000 1.0000"/><keyframe time="49/24s" value="1.0000 1.0000"/></keyframeAnimation></param></adjust-transform><asset-clip ref="r8" name="White flash" lane="1" offset="2/3s" start="0s" duration="1/8s"/><marker start="2/3s" duration="1/24s" value="Bass drop: impact"/></asset-clip><asset-clip name="glasses" ref="r9" offset="83/12s" start="1/3s" duration="11/24s" format="r1" tcFormat="NDF"><adjust-transform><param name="scale" key="scale"><keyframeAnimation><keyframe time="1/3s" value="1.0600 1.0600"/><keyframe time="11/24s" value="1.0300 1.0300"/><keyframe time="7/12s" value="1.0000 1.0000"/><keyframe time="19/24s" value="1.0000 1.0000"/></keyframeAnimation></param></adjust-transform></asset-clip><asset-clip name="hero" ref="r10" offset="59/8s" start="1/2s" duration="11/6s" format="r1" tcFormat="NDF"><note>GROOVE 7.38s: low hero shot, sneakers through the puddle (new Higgsfield shot)</note><adjust-transform><param name="scale" key="scale"><keyframeAnimation><keyframe time="1/2s" value="1.0800 1.0800"/><keyframe time="2/3s" value="1.0400 1.0400"/><keyframe time="5/6s" value="1.0000 1.0000"/><keyframe time="7/3s" value="1.0000 1.0000"/></keyframeAnimation></param></adjust-transform><marker start="1/2s" duration="1/24s" value="Hi-hats in: hero walk"/></asset-clip><asset-clip name="runway" ref="r11" offset="221/24s" start="17/12s" duration="11/6s" format="r1" tcFormat="NDF"><note>the walk continues</note></asset-clip><asset-clip name="sneaker" ref="r12" offset="265/24s" start="1/3s" duration="11/24s" format="r1" tcFormat="NDF"><note>fashion percussion, one insert per beat</note><adjust-transform><param name="scale" key="scale"><keyframeAnimation><keyframe time="1/3s" value="1.0600 1.0600"/><keyframe time="11/24s" value="1.0300 1.0300"/><keyframe time="7/12s" value="1.0000 1.0000"/><keyframe time="19/24s" value="1.0000 1.0000"/></keyframeAnimation></param></adjust-transform><